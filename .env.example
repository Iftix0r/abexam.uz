SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — leave DB_NAME blank to use local SQLite instead.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Email (parol tiklash uchun)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# OpenAI
OPENAI_API_KEY=sk-...

# Telegram admin notifications (register/login/logout activity) — optional,
# feature is silently disabled if left blank. Get the token from @BotFather;
# get the chat ID by messaging your bot then opening
# https://api.telegram.org/bot<token>/getUpdates and reading "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Student bot (navbat, natijalar) — same token. Username without @.
# After deploy run once:  python manage.py tg_webhook set
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# `python manage.py tg_webhook set` muvaffaqiyatli bo'lgach True qiling.
TELEGRAM_HIDDEN_WEBHOOK_ONLY=False
SITE_URL=https://abexam.uz

# Cloudflare Turnstile — ikkalasi bo'sh bo'lsa CAPTCHA o'chirilgan bo'ladi.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin sessiyasi: 4 soat va IP /24 + brauzerga bog'langan.
STAFF_SESSION_MAX_AGE=14400
STAFF_SESSION_BINDING=True

# Error tracking (optional) — leave blank to disable. Free DSN from sentry.io.
SENTRY_DSN=

# Slow query log threshold in seconds, written to logs/slow_queries.log.
# Set to 0 to disable.
SLOW_QUERY_THRESHOLD=0.5
